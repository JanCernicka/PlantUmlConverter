@startuml edge_cases
/'
  Block comment spanning
  multiple lines. Contains 'quotes' and @enduml-like text: @end
'/
' single-line comment
!pragma useIntermediatePackages false
set separator .
left to right direction
title <b>PlantUML</b> class diagram\n<i>edge cases</i>

' =========================================================
' 1. PREPROCESSOR
' =========================================================
!$prefix = "Gen"
!define ENTITY(n) class n <<Entity>> #F0F0F0
!procedure $dto($name, $field)
class $name <<DTO>> {
  +$field : String
}
!endprocedure
!function $upper($s)
!return %upper($s)
!endfunction

ENTITY(MacroEntity)
$dto("GeneratedDto", "payload")
class $prefix##Class
class $upper("shouting")

!if %true()
class ConditionalYes
!else
class ConditionalNo
!endif

' =========================================================
' 2. NAMES
' =========================================================
class "Name With Spaces" as NWS
class "Weird <Chars> & {braces}" as Weird
class "class" as KeywordName
class Účet
class "日本語 クラス" as JP
class A_1.B$c
class UPPER_snake_Case123
class "Multi\nLine\nName" as MLN
class ns1.ns2.Deep {
  -depth : int
}
ns1.ns2.Deep --> ns1.Shallow

' =========================================================
' 3. BODY FORMS
' =========================================================
class Empty1 {}
class Empty2 { }
class Empty3{
}
class NoBody
class Spot << (S,#FF7700) Singleton >>
class NoSpace<<Tight>>
class Multi <<A>> <<B>> <<C>>

class Members {
  {field} weirdField()
  {method} looksLikeField
  +{static} {abstract} both() : void
  -{classifier} CONST : int = 42
  #defaults(x : int = 5, y : String = "a,b") : void
  ~varargs(args : String...) : void
  +arr : int[][]
  +nested : Map<String, List<? extends Comparable<T>>>
  +fn : (int, int) -> int
  +  spaced  :   Type
  __
  ..
  ==
  -- with title --
  .. dotted title ..
  == double title ==
  __ underscore title __
  <b>bold</b> : <color:red>red</color>
  <&key> iconField : String
  +escaped : "quote\"inside"
  +{method} m() : Map<K, V>
}

' members declared outside the body
Members : +outside : int
Members : +outsideMethod(a : A) : B
NoBody : implicit()

' duplicate declaration merges
class Dup {
  +first : int
}
class Dup {
  +second : int
}

' =========================================================
' 4. GENERICS & DECLARATION KEYWORDS
' =========================================================
class Box<T>
class Pair<K, V>
class Bounded<T extends Number & Comparable<T>>
interface Func<in T, out R>
abstract Shape
abstract class AbstractShape
interface IShape
annotation Ann
enum Color {
RED
GREEN
BLUE
}
enum Planet {
  MERCURY(3.303e+23)
  EARTH(5.976e+24)
  --
  -mass : double
}
entity Ent
protocol Proto
struct Str
exception Exc
metaclass Meta
stereotype Stereo
circle Circ
diamond Dia
() "Lollipop Iface" as LI
object obj1 {
  name = "x"
  value = 42
}
map MapObj {
  key1 => value1
  key2 => value2
}

class Child extends AbstractShape implements IShape, Comparable
class Child2 implements IShape

' =========================================================
' 5. PACKAGES
' =========================================================
package EmptyPkg {
}
package "Pkg With Spaces" as PWS #LightYellow {
  class InPWS
}
package outer {
  package inner {
    package innermost <<Database>> {
      class Leaf
    }
  }
}
namespace net.dummy #DDDDDD {
  class Person
  .Person <|- Employee
}
package p1.p2.p3 <<Node>> {
  class Dotted
}
package "Styles" {
  package sFolder <<Folder>> {
  }
  package sFrame <<Frame>> {
  }
  package sCloud <<Cloud>> {
  }
  package sRect <<Rectangle>> {
  }
}

' =========================================================
' 6. ARROWS
' =========================================================
' heads
R1 <|-- R2
R3 --|> R4
R5 <|.. R6
R7 *-- R8
R9 --* R10
R11 o-- R12
R13 --o R14
R15 #-- R16
R17 x-- R18
R19 }-- R20
R21 +-- R22
R23 ^-- R24
R25 <--> R26
R27 <|--|> R28
R29 *--o R30
R31 -- R32
R33 .. R34
R35 ..> R36
R37 <.. R38
R39 - R40
R41 . R42

' lengths and directions
L1 --- L2
L3 ---- L4
L5 -up-> L6
L7 -down-> L8
L9 -left-> L10
L11 -right-> L12
L13 -u-> L14
L15 -l-|> L16
L17 .r.> L18
L19 -[hidden]- L20
L21 -[norank]-> L22

' styles
S1 -[#red]-> S2
S3 -[#blue,dashed]-> S4
S5 -[#green,thickness=4]-> S6
S7 -[bold]-> S8
S9 -[dotted]-> S10
S11 -[#red,#blue]-> S12
S13 -[#FF00FF,dashed,thickness=2]up-> S14

' labels and multiplicities
M1 "1" *-- "0..*" M2 : contains >
M3 "many" o-- "1..n" M4 : < belongs to
M5 "   " -- " " M6 : "  "
M7 -- M8 : label with "quotes"
M9 --> M10 : multi\nline\nlabel
M11 "role a\n[1]" --> "role b\n[*]" M12
M13 --> M14 : <b>creole</b> <i>label</i>
M15 "1" --> M16 : one side only

' member to member
Members::outside --> Dup::first
Dup::second --> Box

' self and parallel links
Selfie --> Selfie : recursion
Selfie "1" o-- "*" Selfie : children
Par1 --> Par2
Par1 --> Par2 : second
Par1 ..> Par2 : third

' association classes and n-ary
Stud "*" -- "*" Course
(Stud, Course) .. Enrollment
(Stud, Course) . Grade
Tri1 -- Dia
Tri2 -- Dia
Tri3 -- Dia

' qualified associations
Map1 [key : String] --> Val1
Map2 [a, b] -- [c] Map3

' sockets (the -() lollipops live in a separate diagram below)
Sock1 -0)- Sock2
Sock3 -(0- Sock4
Sock5 -(0)- Sock6
LollyImpl -- LI

' link to a package
Leaf --> inner

' =========================================================
' 7. COLORS, LINKS, TAGS
' =========================================================
class Colored #pink;line:red;line.dashed;text:blue
class Gradient #red|green
class Gradient2 #red/blue
class Gradient3 #red-yellow
class Gradient4 #red\blue
class Linked [[https://plantuml.com]]
class Tooltip [[https://plantuml.com{hover text}]]
class Tagged $tagA $tagB
class Tagged2 $tagA

' =========================================================
' 8. NOTES
' =========================================================
note top of Members : one-liner note
note left of Members::both
  note on a member
end note
note right of Box
  * bullet
  ** nested bullet
  # numbered
  |= Header |= Col |
  | cell | <#yellow> colored |
  <code>
  code(block) { }
  </code>
  [[https://example.com link]]
  ----
  <u>underline</u> <s>strike</s> <w>wavy</w>
end note
note "floating" as FN
FN .. Box
FN .. Pair
note as FN2 #aqua
  floating multi-line
  with color
end note
R1 <|-- R2
note on link : note on the last link
M1 --> M2
note left on link #lightgreen
  multi-line
  note on link
end note

' =========================================================
' 9. VISIBILITY / HIDE / SHOW / REMOVE
' =========================================================
skinparam classAttributeIconSize 0
skinparam class<<Tight>> {
  BackgroundColor #FFEEEE
  BorderColor red
}
skinparam {
  ArrowColor #333333
}
hide empty fields
hide Empty1 methods
show Members fields
hide <<DTO>> circle
hide <<Tight>> stereotype
hide Tagged2
hide $tagB
hide @unlinked
remove Gradient4
restore Gradient4
hide Colored members
show Colored fields

together {
  class T1
  class T2
  class T3
}

legend top left
  Legend with <b>creole</b>
  | a | b |
endlegend

caption This is a caption
center header Centered header
right footer %date("yyyy-MM-dd")

@enduml

' =========================================================
' Second diagram in the same file: lollipops.
' -() cannot coexist with diamond/object/protocol/metaclass/stereotype
' =========================================================
@startuml lollipops
class LollyImpl
LollyImpl -() Lolly
LollyImpl --() Lolly2
@enduml

' =========================================================
' Third diagram: allowmixing (breaks -() lollipops)
' =========================================================
@startuml mixing
allowmixing
class Service
component Comp
actor Act
database DB
usecase UC
Act --> UC
UC ..> Service
Service --> Comp
Comp --> DB
@enduml
